POSTGRES_DB=wallet_scan
POSTGRES_USER=scanner
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://scanner:replace-with-a-long-random-password@postgres:5432/wallet_scan?sslmode=disable
BIND_ADDRESS=0.0.0.0:8080
SCANNER_BIND_PORT=8080
SCANNER_BIND_HOST=127.0.0.1
# Optional when the service is bound to a private network address.
SCANNER_API_KEY=
API_MAX_IN_FLIGHT=100
API_INITIAL_CONCURRENCY=20
API_QUEUE_WAIT_MS=250
API_ADJUST_INTERVAL_SECONDS=5
API_TARGET_LATENCY_MS=800
WECOM_WEBHOOK_URL=
SCAN_MODE=once
BATCH_SIZE=100
MAX_RETRIES=3
EMPTY_RETENTION_DAYS=7
REQUEST_TIMEOUT_SECONDS=12
ADDRESS_WORKERS=8
NODE_FAILURE_THRESHOLD=5
RETRY_BASE_DELAY_SECONDS=2

BTC_API_URL=https://mempool.space/api
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ARB_RPC_URL=https://arb1.arbitrum.io/rpc
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
SOL_RPC_URL=https://solana-rpc.publicnode.com
TRON_API_URL=https://api.trongrid.io

BTC_CONCURRENCY=2
ETH_CONCURRENCY=4
ARB_CONCURRENCY=4
BSC_CONCURRENCY=4
SOL_CONCURRENCY=2
TRON_CONCURRENCY=2
